# ==========================================
# DEX SCREENER & BINANCE MONITOR CONFIG
# ==========================================

# Telegram Bot Alerts (Оставьте пустыми, если алерт нужен только в консоль)
TG_BOT_TOKEN=
TG_CHAT_ID=

# MongoDB Storage (Для сохранения сигналов и последующего квант-анализа)
MONGO_DB_URL=
MONGO_DB_NAME=dex_radar
MONGO_COLLECTION=signals

# Binance Фильтры суточного объема (в USD)
MIN_BINANCE_VOL_USD=500000
MAX_BINANCE_VOL_USD=100000000

# Bybit Фильтры (эксклюзивные криптотокены, отсутствующие на Binance)
ENABLE_BYBIT=true
MIN_BYBIT_VOL_USD=400000
MAX_BYBIT_VOL_USD=100000000

# DexScreener Фильтры
MIN_DEX_LIQ_USD=80000

# Период проверки (в секундах)
CHECK_INTERVAL_SEC=180

# Временные окна (1 час и 3 часа)
WINDOW_1H_SEC=3600
WINDOW_3H_SEC=10800
MAX_HISTORY_WINDOW_SEC=10800

# Пороги для сигнала ШОРТ:
# LIQ_DROP_THRESHOLD_PCT: Минимальное падение ликвидности в % (например -12.0)
LIQ_DROP_THRESHOLD_PCT=-12.0

# MAX_PRICE_DROP_PCT: Максимально допустимое падение цены (цена еще не успела упасть, держится выше -2.5%)
MAX_PRICE_DROP_PCT=-2.5

# Динамические фильтры качества ликвидности (Защита от фейковых и мертвых пулов)
MIN_DRAIN_COHERENCE_RATIO=0.15
MIN_DRAIN_IMPACT_PCT=0.015
MIN_POOL_TXNS_H1=5
MIN_QUOTE_TVL_SHARE_PCT=2.0

# Что отслеживать: 'quote' (резерв котируемого токена), 'usd' (TVL в долларах), или 'both' (оба)
TRACK_MODE=quote

# Кулдаун между повторными алертами по одной и той же монете (в секундах, 3600 = 1 час)
ALERT_COOLDOWN_SEC=3600

# Пути к файлам данных
POOLS_MAP_FILE=data/binance_dex_map.json
STATE_FILE=data/pools_state.json
SIGNALS_FILE=data/signals_history.json
